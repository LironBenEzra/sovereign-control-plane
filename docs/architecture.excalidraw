      "groupIds": [
        "failclosed"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 400922,
      "version": 2,
      "versionNonce": 1485346003,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795157350913,
      "link": null,
      "locked": false,
      "text": "FAIL CLOSED — when unsure, protect\n• detector error or timeout → assume private\n• only low-confidence findings → treat as private\n• policy missing or invalid → block everything\n• no rule matches → block\n• decision record not written → 503, no model call\n• sovereign model down → block, never external\n• destination not allowlisted → egress refused\n• output scan or outcome record fails → withhold response",
      "originalText": "FAIL CLOSED — when unsure, protect\n• detector error or timeout → assume private\n• only low-confidence findings → treat as private\n• policy missing or invalid → block everything\n• no rule matches → block\n• decision record not written → 503, no model call\n• sovereign model down → block, never external\n• destination not allowlisted → egress refused\n• output scan or outcome record fails → withhold response",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ab"
    },
