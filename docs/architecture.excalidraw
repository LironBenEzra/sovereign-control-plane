    {
      "id": "text-38",
      "type": "text",
      "x": 500,
      "y": 436,
      "width": 495.9,
      "height": 168.75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
