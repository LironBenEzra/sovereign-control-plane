      "boundElements": [],
      "updated": 1795158951497,
      "link": null,
      "locked": false,
      "text": "AUDIT LOG  ·  tamper-evident evidence\nappend-only JSONL · SHA-256 hash chain · Ed25519 signature per record · signed receipt returned to the caller\nstores keyed hashes (HMAC), never raw private values · each policy version snapshotted by its SHA-256",
      "originalText": "AUDIT LOG  ·  tamper-evident evidence\nappend-only JSONL · SHA-256 hash chain · Ed25519 signature per record · signed receipt returned to the caller\nstores keyed hashes (HMAC), never raw private values · each policy version snapshotted by its SHA-256",
      "fontSize": 14,
      "fontFamily": 5,
