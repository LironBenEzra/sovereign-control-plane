# Copy this file to .env. Every value is optional: the system runs without any of them.

# With a key, "allow" and "redact" requests go to the real Anthropic API.
# Without one, they go to a stub that is labelled as a stub in every audit record.
ANTHROPIC_API_KEY=

# The external model. Used only when a key is set.
# SCP_EXTERNAL_MODEL=claude-opus-5-5

# The sovereign (in-boundary) model served by Ollama. Any model Ollama can pull.
# SCP_SOVEREIGN_MODEL=llama3.2:1b

# Set to "stub" to run without Ollama at all.
# SCP_SOVEREIGN_PROVIDER=stub
