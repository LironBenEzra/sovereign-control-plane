# Copy this file to .env.

# "allow" and "redact" requests go to the Anthropic API. Without a key they are refused
# (HTTP 503), and every audit record says why; prompts that stay inside still work.
ANTHROPIC_API_KEY=

# The external model.
# SCP_EXTERNAL_MODEL=claude-opus-5-5

# The sovereign (in-boundary) model served by Ollama. It also runs the semantic
# detector, so check a replacement with `make eval-semantic`. Any model Ollama can pull.
# SCP_SOVEREIGN_MODEL=llama3.2:3b

# Set to "stub" to run without Ollama at all.
# SCP_SOVEREIGN_PROVIDER=stub
